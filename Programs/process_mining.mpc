from Compiler.types import Array, Matrix, MemValue, regint, sint
from Compiler.library import print_ln, for_range, if_, start_timer, stop_timer, for_range_opt_multithread, for_range_opt
from Compiler.GC.types import sbitint, sbit

# --- CONFIGURATION ---
# Default values
N_PER_PARTY = 8
PARTIAL_LEN = 3
N_THREADS = 16
THRESHOLD = 1
N_PARTIES = 2
ENABLE_K_ANON = 0
ENABLE_PARTIAL_ORDERS = 0
ENABLE_DP = 0
EPSILON_NUM = 1000   # epsilon = EPSILON_NUM / EPSILON_DEN
EPSILON_DEN = 1000   # default: epsilon = 1.0
DP_K = 0             # Partition selection threshold k, derived from (epsilon, delta) in Python
DELTA = 0            # Concurrency window in ms. 0 = exact equality (EQZ, cheaper); >0 = sliding window (LTZ).

# 1. Try to load from program.args (Standard MP-SPDZ)
try:
    if len(program.args) > 1: N_PER_PARTY = int(program.args[1])
    if len(program.args) > 2: PARTIAL_LEN = int(program.args[2])
    if len(program.args) > 3: N_THREADS = int(program.args[3])
    if len(program.args) > 4: THRESHOLD = int(program.args[4])
    if len(program.args) > 5: ENABLE_K_ANON = int(program.args[5])
except:
    pass

# 2. Try to load from Neon Substitution
# Neon will replace the string literals 'NEON_ARG_...' with their values (e.g. '635').
# If not replaced, int('NEON_ARG...') raises ValueError, and we stick to previous values.
try:
    N_PER_PARTY = int('NEON_ARG_N_PER_PARTY')
except ValueError:
    pass

try:
    PARTIAL_LEN = int('NEON_ARG_PARTIAL_LEN')
except ValueError:
    pass

try:
    N_THREADS = int('NEON_ARG_N_THREADS')
except ValueError:
    pass

try:
    THRESHOLD = int('NEON_ARG_THRESHOLD')
except ValueError:
    pass

try:
    ENABLE_K_ANON = int('NEON_ARG_ENABLE_K_ANON')
except ValueError:
    pass

try:
    ENABLE_PARTIAL_ORDERS = int('NEON_ARG_ENABLE_PARTIAL_ORDERS')
except ValueError:
    pass

try:
    ENABLE_DP = int('NEON_ARG_ENABLE_DP')
except ValueError:
    pass

try:
    EPSILON_NUM = int('NEON_ARG_EPSILON_NUM')
except ValueError:
    pass

try:
    EPSILON_DEN = int('NEON_ARG_EPSILON_DEN')
except ValueError:
    pass

try:
    DELTA = int('NEON_ARG_DELTA')
except ValueError:
    pass

try:
    DP_K = int('NEON_ARG_DP_K')
except ValueError:
    pass

try:
    N_PARTIES = int('NEON_ARG_N_PARTIES')
except ValueError:
    pass

print_ln("Final Config: N=%s, Partial_Len=%s, Threads=%s, Threshold=%s, K-Anon=%s, PO=%s, DP=%s, Delta=%s, DP_K=%s, Parties=%s", N_PER_PARTY, PARTIAL_LEN, N_THREADS, THRESHOLD, ENABLE_K_ANON, ENABLE_PARTIAL_ORDERS, ENABLE_DP, DELTA, DP_K, N_PARTIES)

TOTAL_N = N_PER_PARTY * N_PARTIES
FULL_LEN = PARTIAL_LEN * N_PARTIES
COLS_PER_EVENT = 2
ROW_WIDTH = 2 + (PARTIAL_LEN * COLS_PER_EVENT)
ACT_BITS = 17  # Bits reserved for activity ID in composite sort key (supports up to 131072 activities)

# FORCE BINARY TYPE
sint64 = sbitint.get_type(64)

def main():
    print_ln("Config: N=%s, Partial_Len=%s, Threshold=%s, K-Anon=%s", N_PER_PARTY, PARTIAL_LEN, THRESHOLD, ENABLE_K_ANON)
    
    data = sint64.Matrix(TOTAL_N, ROW_WIDTH)

    # --- Step 1: Reading Inputs ---
    # --------------------
    # STEP 1: READ INPUTS
    # --------------------
    print_ln("Reading inputs...")
    #neon_timer: Reading Inputs NEON_TIMER_INPUTS
    start_timer(NEON_TIMER_INPUTS)
    
    for p in range(N_PARTIES):
        for i in range(N_PER_PARTY):
            row = p * N_PER_PARTY + i
            data[row][0] = sint64.get_input_from(p)
            data[row][1] = sint64(p)
            for j in range(PARTIAL_LEN):
                data[row][2 + j*2] = sint64.get_input_from(p)
                data[row][2 + j*2 + 1] = sint64.get_input_from(p)
            
    stop_timer(NEON_TIMER_INPUTS)

    # --- Step 2: PSI ---
    print_ln("PSI (Bitonic Merge)")
    #neon_timer: PSI Bitonic Merge NEON_TIMER_PSI
    start_timer(NEON_TIMER_PSI)
    
    # --- Iterative Bitonic Merge (unified for all N >= 2) ---
    # After input: data[0..N_PER_PARTY-1] = P0 (ascending)
    #              data[p*N_PER_PARTY..(p+1)*N_PER_PARTY-1] = Pp (descending for p>=1)
    # We iteratively merge: result_so_far (ascending) with next party (descending).
    # For N=2, the loop runs exactly once and is equivalent to the classic 2-party
    # bitonic merge (P0 ascending + P1 descending forms a bitonic sequence).

    merged_size = N_PER_PARTY  # starts with P0 already in data[0..N_PER_PARTY-1]

    for p in range(1, N_PARTIES):  # compile-time loop over parties
        new_party_start = p * N_PER_PARTY
        total_size = merged_size + N_PER_PARTY

        # Pad to next power of 2
        POW2 = 1
        while POW2 < total_size:
            POW2 *= 2

        padded_iter = sint64.Matrix(POW2, ROW_WIDTH)

        # A) Copy merged result (ascending) → indices 0..merged_size-1
        @for_range_opt_multithread(N_THREADS, merged_size)
        def _(i):
            for c in range(ROW_WIDTH):
                padded_iter[i][c] = data[i][c]

        # B) Fill padding → indices merged_size..POW2-N_PER_PARTY-1
        iter_pad_start = merged_size
        iter_pad_end = POW2 - N_PER_PARTY
        if iter_pad_end > iter_pad_start:
            pad_count = iter_pad_end - iter_pad_start
            @for_range_opt_multithread(N_THREADS, pad_count)
            def _(k):
                idx = iter_pad_start + k
                padded_iter[idx][0] = sint64(2**60)
                for c in range(1, ROW_WIDTH):
                    padded_iter[idx][c] = sint64(0)

        # C) Copy next party (descending) → indices POW2-N_PER_PARTY..POW2-1
        nps = new_party_start  # capture for closure
        ipe = iter_pad_end     # capture for closure
        @for_range_opt_multithread(N_THREADS, N_PER_PARTY)
        def _(k):
            target_idx = ipe + k
            src_idx = nps + k
            for c in range(ROW_WIDTH):
                padded_iter[target_idx][c] = data[src_idx][c]

        # Bitonic Merge Network
        step = POW2 // 2
        while step > 0:
            n_ops = POW2 // 2
            step_val = step
            @for_range_opt_multithread(N_THREADS, n_ops)
            def _(i):
                k = i % step_val
                j = (i // step_val) * (2 * step_val)
                idx1 = j + k
                idx2 = idx1 + step_val
                key_a = padded_iter[idx1][0]
                key_b = padded_iter[idx2][0]
                swap = (key_a > key_b)
                for c in range(ROW_WIDTH):
                    val_a = padded_iter[idx1][c]
                    val_b = padded_iter[idx2][c]
                    padded_iter[idx1][c], padded_iter[idx2][c] = swap.cond_swap(val_a, val_b)
            step //= 2

        # Copy sorted result back to data[0..total_size-1]
        ts = total_size  # capture for closure
        @for_range_opt_multithread(N_THREADS, ts)
        def _(i):
            for c in range(ROW_WIDTH):
                data[i][c] = padded_iter[i][c]

        merged_size = total_size

    stop_timer(NEON_TIMER_PSI)

    # --- Step 3: Reconstruction ---
    print_ln("Reconstruction")
    #neon_timer: Reconstruction NEON_TIMER_RECON
    start_timer(NEON_TIMER_RECON)
    # Layout: [hash, is_invalid, act_0..act_{FULL_LEN-1}]
    # When PO enabled, act_k stores packed value: activity_id | (conc_bit << 32)
    #   conc_bit=1 means act_k shares a timestamp with act_{k-1} (same concurrent set)
    MERGED_COLS = 2 + FULL_LEN
    merged_data = sint64.Matrix(TOTAL_N, MERGED_COLS)
    merged_data.assign_all(0)

    MAX_TIME = 2**60

    # --- Helper: pruned bitonic merge on compile-time Python lists ---
    # Used by both N=2 and N>=3 paths for the inner event merge.
    # Merges ascending (positions 0..merged_count-1) with descending (positions POW2-new_count..POW2-1).
    # Padding fills the middle. Returns (keys, ts, act, padding) lists after merge.
    def pruned_bitonic_merge(sort_keys, sort_vals_ts, sort_vals_act, is_padding, POW2):
        step = POW2 // 2
        while step > 0:
            pairs = []
            for j in range(0, POW2, step * 2):
                for kk in range(step):
                    pairs.append((j + kk, j + kk + step))

            batch_pairs = []
            batch_keys_a = []
            batch_keys_b = []
            batch_ts_a = []
            batch_ts_b = []
            batch_act_a = []
            batch_act_b = []

            for idx1, idx2 in pairs:
                p1 = is_padding[idx1]
                p2 = is_padding[idx2]
                if p1 and p2:
                    pass
                elif not p1 and p2:
                    pass
                elif p1 and not p2:
                    sort_keys[idx1] = sort_keys[idx2]
                    sort_vals_ts[idx1] = sort_vals_ts[idx2]
                    sort_vals_act[idx1] = sort_vals_act[idx2]
                    sort_keys[idx2] = sint64(MAX_TIME)
                    sort_vals_ts[idx2] = sint64(MAX_TIME)
                    sort_vals_act[idx2] = sint64(0)
                    is_padding[idx1] = False
                    is_padding[idx2] = True
                else:
                    batch_pairs.append((idx1, idx2))
                    batch_keys_a.append(sort_keys[idx1])
                    batch_keys_b.append(sort_keys[idx2])
                    batch_ts_a.append(sort_vals_ts[idx1])
                    batch_ts_b.append(sort_vals_ts[idx2])
                    batch_act_a.append(sort_vals_act[idx1])
                    batch_act_b.append(sort_vals_act[idx2])

            if batch_pairs:
                swaps = [(a > b) for a, b in zip(batch_keys_a, batch_keys_b)]
                # cond_swap: shared XOR, 64 AND per array instead of 128
                new_keys_a, new_keys_b = zip(*[s.cond_swap(a, b) for s, a, b in zip(swaps, batch_keys_a, batch_keys_b)]) if swaps else ([], [])
                new_ts_a, new_ts_b = zip(*[s.cond_swap(a, b) for s, a, b in zip(swaps, batch_ts_a, batch_ts_b)]) if swaps else ([], [])
                new_act_a, new_act_b = zip(*[s.cond_swap(a, b) for s, a, b in zip(swaps, batch_act_a, batch_act_b)]) if swaps else ([], [])
                for idx, (idx1, idx2) in enumerate(batch_pairs):
                    sort_keys[idx1] = new_keys_a[idx]
                    sort_keys[idx2] = new_keys_b[idx]
                    sort_vals_ts[idx1] = new_ts_a[idx]
                    sort_vals_ts[idx2] = new_ts_b[idx]
                    sort_vals_act[idx1] = new_act_a[idx]
                    sort_vals_act[idx2] = new_act_b[idx]

            step //= 2
        return sort_keys, sort_vals_ts, sort_vals_act, is_padding

    # --- Helper: load PARTIAL_LEN events from data[src_row] into sort buffers ---
    # positions[k] gives the target index for the k-th event in the row.
    # Use positions=range(PARTIAL_LEN) for ascending (initial party) or
    # positions=[end-k for k in ...] for reversed (subsequent parties in bitonic merge).
    def load_events(src_row, dst_keys, dst_ts, dst_act, dst_pad, positions):
        for k in range(PARTIAL_LEN):
            idx = positions[k]
            ts = data[src_row][2 + k*2]
            act = data[src_row][2 + k*2 + 1]
            if ENABLE_PARTIAL_ORDERS:
                is_real = (ts != sint64(MAX_TIME))
                composite = (ts << ACT_BITS) | act
                dst_keys[idx] = is_real.if_else(composite, sint64(MAX_TIME))
            else:
                dst_keys[idx] = ts
            dst_ts[idx] = ts
            dst_act[idx] = act
            dst_pad[idx] = False

    # --- Helper: extract sorted activities into merged_data ---
    def extract_activities(sort_vals_ts, sort_vals_act, target_row, is_match_mask):
        # is_match_mask: sint64 with all 64 bits = match_bit (N>=3),
        #                or sbit (N=2, uses .if_else which works correctly for sbit).
        for k in range(FULL_LEN):
            ts = sort_vals_ts[k]
            act = sort_vals_act[k]
            # Padding positions always have act=sint64(0) by construction (sort buffer
            # init + padding_data compile-time branch in pruned_bitonic_merge explicitly
            # sets act to 0). Real activities start at ID 1 (preprocessing reserves 0
            # for padding). So `is_pad.if_else(0, act)` is equivalent to `act`.
            final_act = act
            if ENABLE_PARTIAL_ORDERS:
                if k == 0:
                    merged_data[target_row][2 + k] = final_act & is_match_mask
                else:
                    prev_ts = sort_vals_ts[k - 1]
                    if DELTA == 0:
                        is_close = (ts == prev_ts)
                    else:
                        diff = ts - prev_ts
                        is_close = (diff < sint64(DELTA))
                    both_valid = (ts != sint64(MAX_TIME)) & (prev_ts != sint64(MAX_TIME))
                    is_conc = is_close & both_valid
                    packed = final_act | (is_conc << 32)
                    merged_data[target_row][2 + k] = packed & is_match_mask
            else:
                merged_data[target_row][2 + k] = final_act & is_match_mask

    # === Unified sliding-window reconstruction (all N >= 2) ===
    # For each position i, check whether the window of N consecutive rows
    # starting at i has the same case_id (and is not padding).
    # Under the preprocessing invariant (each party has ≤1 row per case_id),
    # this uniquely identifies N-way intersection groups: exactly one window
    # per valid match fires, surrounding windows include a different case_id.
    # Fully parallel — no sequential MemValue scan.
    # For N=2, the equality chain has a single link (data[i]==data[i+1]) and the
    # iterative merge runs one iteration (P0 asc + P1 desc → bitonic merge).

    @for_range_opt_multithread(N_THREADS, TOTAL_N - (N_PARTIES - 1))
    def _(i):
        PAD_VAL = sint64(2**60)

        # Chain of adjacent equality checks: (r0==r1) & (r1==r2) & ... & (r_{N-2}==r_{N-1})
        all_same = (data[i][0] == data[i+1][0])
        for j in range(1, N_PARTIES - 1):
            all_same = all_same & (data[i+j][0] == data[i+j+1][0])
        is_valid_id = (data[i][0] != PAD_VAL)
        is_match = all_same & is_valid_id  # sbit (from comparison chain)
        # Store validity bit (0=match, 1=invalid); sbit auto-casts into sint64 Matrix
        merged_data[i][1] = is_match.if_else(sint64(0), sint64(1))
        # Broadcast sbit to full 64-bit mask (0x0 or 0xFF...FF) for the AND masking
        # in extract_activities. Using .if_else directly avoids the sbit-to-sint64
        # conversion ambiguity that ~x+1 needs.
        is_match_mask = is_match.if_else(sint64(-1), sint64(0))

        # --- Iterative bitonic merge of N_PARTIES * PARTIAL_LEN events ---
        # Window starts at row i, so events come from rows i, i+1, ..., i+N-1.

        # Initialize with party 0's events (row i)
        INIT_POW2 = 1
        while INIT_POW2 < PARTIAL_LEN:
            INIT_POW2 *= 2

        cur_keys = [sint64(MAX_TIME)] * INIT_POW2
        cur_ts = [sint64(MAX_TIME)] * INIT_POW2
        cur_act = [sint64(0)] * INIT_POW2
        cur_pad = [True] * INIT_POW2

        # Load row i's events ascending at positions [0..PARTIAL_LEN-1]
        load_events(i, cur_keys, cur_ts, cur_act, cur_pad, list(range(PARTIAL_LEN)))

        merged_count = PARTIAL_LEN

        # Iteratively merge each subsequent party's events
        for p in range(1, N_PARTIES):  # compile-time loop
            total_count = merged_count + PARTIAL_LEN
            POW2 = 1
            while POW2 < total_count:
                POW2 *= 2

            # Create merge buffer: [merged ascending | padding | new party reversed]
            m_keys = [sint64(MAX_TIME)] * POW2
            m_ts = [sint64(MAX_TIME)] * POW2
            m_act = [sint64(0)] * POW2
            m_pad = [True] * POW2

            # Copy merged result (ascending) to start
            for k in range(merged_count):
                m_keys[k] = cur_keys[k]
                m_ts[k] = cur_ts[k]
                m_act[k] = cur_act[k]
                m_pad[k] = cur_pad[k]

            # Load row i+p's events reversed (descending) at positions [POW2-1..POW2-PARTIAL_LEN]
            reversed_positions = [POW2 - 1 - k for k in range(PARTIAL_LEN)]
            load_events(i + p, m_keys, m_ts, m_act, m_pad, reversed_positions)

            # Pruned bitonic merge
            pruned_bitonic_merge(m_keys, m_ts, m_act, m_pad, POW2)

            # Carry forward the sorted result for next iteration
            cur_keys = m_keys
            cur_ts = m_ts
            cur_act = m_act
            cur_pad = m_pad
            merged_count = total_count

        # Extract sorted activities into merged_data[i]
        extract_activities(cur_ts, cur_act, i, is_match_mask)

    # Mark last N_PARTIES - 1 rows as invalid (can't start a valid window)
    for j in range(N_PARTIES - 1):
        merged_data[TOTAL_N - 1 - j][1] = sint64(1)

    stop_timer(NEON_TIMER_RECON)

    # --- Step 4: Robust Binary Hashing ---
    print_ln("--- [TIMESTAMP] Starting Step 4: Binary Hashing (In-Place) ---")
    #neon_timer: Hashing NEON_TIMER_HASH
    start_timer(NEON_TIMER_HASH)
    
    # Write hashes directly into merged_data[i][0].
    # All operations are XOR/shift → 0 AND gates, 0 communication, free.
    # When PO is enabled, merged_data[i][2+k] stores packed (activity | conc_bit<<32);
    # when PO is disabled it stores plain activity IDs. The hash is identical either
    # way because the composite sort key canonicalizes the order within concurrent
    # groups by activity ID, making a sequential hash order-independent.
    @for_range_opt_multithread(N_THREADS, TOTAL_N)
    def _(i):
        h = sint64(0)
        for k in range(1 + FULL_LEN):
            val = merged_data[i][1 + k]
            h = h ^ val
            h = h ^ (h << 10)
            h = h ^ (h >> 6)

        h = h ^ (h << 3)
        h = h ^ (h >> 11)
        h = h ^ (h << 15)

        merged_data[i][0] = h
    stop_timer(NEON_TIMER_HASH)

    # --- Step 5: Secure Grouping (Narrow-Key Sort Optimization) ---
    print_ln("--- [TIMESTAMP] Starting Step 5: Grouping (Narrow-Key Sort) ---")
    #neon_timer: Grouping NEON_TIMER_GROUP
    start_timer(NEON_TIMER_GROUP)
    
    # OPTIMIZATION: Sort a narrow [hash, orig_index, valid_bit] matrix (3 cols)
    # instead of full merged_data (2 + FULL_LEN cols).
    # Every compare-and-swap now moves 3 values instead of 2+FULL_LEN.
    # We include valid_bit so the output pass can determine keep without
    # needing a secret-indexed lookup into merged_data.
    #neon_timer: Grouping Setup NEON_TIMER_GROUP_SETUP
    start_timer(NEON_TIMER_GROUP_SETUP)
    narrow_keys = sint64.Matrix(TOTAL_N, 3)  # [hash, orig_index, valid_bit]
    
    @for_range_opt_multithread(N_THREADS, TOTAL_N)
    def _(i):
        narrow_keys[i][0] = merged_data[i][0]  # hash
        narrow_keys[i][1] = sint64(i)           # original index
        narrow_keys[i][2] = merged_data[i][1]   # valid_bit (match flag)
    stop_timer(NEON_TIMER_GROUP_SETUP)
    
    #neon_timer: Grouping Sort NEON_TIMER_GROUP_SORT
    start_timer(NEON_TIMER_GROUP_SORT)
    narrow_keys.sort(key_indices=[0], n_threads=N_THREADS)
    stop_timer(NEON_TIMER_GROUP_SORT)
    
    #neon_timer: Grouping Count NEON_TIMER_GROUP_COUNT
    start_timer(NEON_TIMER_GROUP_COUNT)
    c_counts = Array(TOTAL_N, sint64) 
    c_counts.assign_all(0)
    is_last = Array(TOTAL_N, sint64)
    is_last.assign_all(0)
    current_group_count = MemValue(sint64(1))
    
    # Serial counting pass — reads hashes from the narrow sorted array
    @for_range_opt(TOTAL_N - 1)
    def _(i):
        h_curr = narrow_keys[i][0]
        h_next = narrow_keys[i+1][0]
        
        is_equal = (h_curr == h_next)
        
        cnt = current_group_count.read()
        new_cnt = is_equal.if_else(cnt + 1, sint64(1))
        current_group_count.write(new_cnt)
        
        is_last_bit = is_equal ^ 1
        is_last[i] = is_last_bit
        c_counts[i] = is_equal.if_else(sint64(0), cnt)

    is_last[TOTAL_N - 1] = sint64(1)
    c_counts[TOTAL_N - 1] = current_group_count.read()
    stop_timer(NEON_TIMER_GROUP_COUNT)
    stop_timer(NEON_TIMER_GROUP)

    # --- Step 5.5: (epsilon, delta)-DP Partition Selection via k-TSGD ---
    # Rafiei et al. (ICPM 2022), based on Desfontaines et al. (2022).
    # k (= DP_K) is computed in Python from (epsilon, delta) and serves as both
    # the noise truncation bound and the frequency threshold (coupled for the
    # (epsilon, delta)-DP guarantee). THRESHOLD is set to k by the Python driver.
    if ENABLE_DP:
        import math
        print_ln("--- Adding DP Noise (epsilon=%s/%s, k=%s) ---", EPSILON_NUM, EPSILON_DEN, DP_K)
        #neon_timer: DP Noise NEON_TIMER_DP_NOISE
        start_timer(NEON_TIMER_DP_NOISE)

        # Compile-time computation of Bernoulli parameters
        epsilon = EPSILON_NUM / EPSILON_DEN
        p_float = math.exp(-epsilon)  # probability for geometric distribution
        M_BITS = 32  # precision of Bernoulli coin
        P_SCALED = int(p_float * (2**M_BITS))
        # k serves as truncation bound: noise ~ k-TSGD(p, k) in [-k, k]
        MAX_NOISE = DP_K

        # Use M_BITS+1 so sign bit is always 0 (unsigned comparison)
        # Without this, sbitint signed comparison treats half the random
        # values as negative, inflating Bernoulli success probability.
        sintM = sbitint.get_type(M_BITS + 1)

        # Adaptive geometric sampling: bit-decomposed (O(log k)) vs sequential (O(k))
        # Bit j of Geometric(1-p) is independent Bernoulli with prob p^(2^j)/(1+p^(2^j))
        # (Ghosh et al. STOC 2009, Champion et al. CCS 2019).
        # Precision requirement: p^(2^n_bits) < 2^(-M_BITS) to match Bernoulli precision.
        n_bits_required = int(math.ceil(math.log2(max(2, M_BITS * math.log(2) / epsilon))))
        n_bits_required = max(n_bits_required, int(math.ceil(math.log2(MAX_NOISE + 1))))
        # +1 accounts for the additional clamp comparison in the bit-decomposed path
        USE_BITDECOMP = (n_bits_required + 1 < MAX_NOISE)

        if USE_BITDECOMP:
            print_ln("DP sampling: bit-decomposed (%s bits vs k=%s sequential)", n_bits_required, MAX_NOISE)
            # Precompute per-bit thresholds at compile time
            bit_thresholds = []
            for j in range(n_bits_required):
                p_j = (p_float ** (2**j)) / (1.0 + p_float ** (2**j))
                bit_thresholds.append(int(p_j * (2**M_BITS)))

            def sample_geometric():
                G = sint64(0)
                for j in range(n_bits_required):
                    random_bits = [sbit.get_random_bit() for _ in range(M_BITS)]
                    R = sintM.bit_compose(random_bits)
                    bit_val = (R < sintM(bit_thresholds[j]))
                    G = G + bit_val.if_else(sint64(2**j), sint64(0))
                # Clamp to MAX_NOISE (handles tail of untruncated geometric)
                over = (G > sint64(MAX_NOISE))
                G = over.if_else(sint64(MAX_NOISE), G)
                return G
        else:
            print_ln("DP sampling: sequential (%s trials, bit-decomp would need %s bits)", MAX_NOISE, n_bits_required)
            # Helper: sample Geometric(1-p) truncated at k via sequential Bernoulli trials
            # Returns sint64 in [0, k]
            def sample_geometric():
                running = sbit(1)
                G = sint64(0)
                for trial in range(MAX_NOISE):
                    # Bernoulli(p): generate M_BITS random bits, compare against threshold
                    random_bits = [sbit.get_random_bit() for _ in range(M_BITS)]
                    R = sintM.bit_compose(random_bits)
                    coin = (R < sintM(P_SCALED))  # 1 with probability p
                    still_running = running & coin
                    increment = still_running.if_else(sint64(1), sint64(0))
                    G = G + increment
                    running = still_running
                return G

        # Apply k-TSGD noise: noise = G1 - G2 where G1, G2 ~ Geometric(1-p) truncated at k
        # Threshold filtering (count > k) happens in the output phase using THRESHOLD = k
        # Multithreaded: each row's noise is independent (no cross-iteration dependencies)
        @for_range_opt_multithread(N_THREADS, TOTAL_N)
        def _(i):
            G1 = sample_geometric()
            G2 = sample_geometric()
            noise = G1 - G2

            noisy = c_counts[i] + noise
            # Clamp to 0 (no negative counts)
            is_neg = (noisy < sint64(0))
            clamped = is_neg.if_else(sint64(0), noisy)

            # Only apply to group representatives (is_last[i] == 1)
            is_rep = (is_last[i] != sint64(0))
            c_counts[i] = is_rep.if_else(clamped, c_counts[i])

        stop_timer(NEON_TIMER_DP_NOISE)
        print_ln("DP_APPLIED Epsilon:%s/%s K:%s", EPSILON_NUM, EPSILON_DEN, DP_K)

    # --- Output (Narrow-Key + Public Index Reveal) ---
    print_ln("--- [TIMESTAMP] Starting Step 6: Output (Batch Reveal) ---")
    #neon_timer: Output Reveal NEON_TIMER_OUTPUT
    start_timer(NEON_TIMER_OUTPUT)
    threshold_sb = sint64(THRESHOLD)
    print_ln("--- Results (Threshold >= %s) ---", threshold_sb.reveal())
    
    # Must use MemValue to pass to threads
    threshold_mem = MemValue(threshold_sb)
    
    should_reveal_arr = Array(TOTAL_N, sint64)
    revealed_counts = Array(TOTAL_N, sint64)
    masked_orig_idx = Array(TOTAL_N, sint64)
    others_counts = Array(TOTAL_N, sint64)
    others_counts.assign_all(0)
    
    # Pass 1: Compute keep mask, counts, and masked original indices.
    # Uses valid_bit from the narrow sorted matrix (no secret indexing needed).
    # THRESHOLD comparison is only compiled when it can matter — when THRESHOLD>1
    # (filtering) or when DP is enabled (noise can push counts negative). When
    # THRESHOLD==1 and DP is off, c_counts[i] is always >= 1 at valid-last
    # positions, so count_ok is tautological and the check is pruned.
    @for_range_opt_multithread(N_THREADS, TOTAL_N)
    def _(i):
        # Read valid_bit from narrow_keys (carried through the sort)
        valid_bit = narrow_keys[i][2]
        is_valid_trace = (valid_bit == 0)
        last_bit = (is_last[i] != 0)
        valid_last = is_valid_trace & last_bit

        if THRESHOLD > 1 or ENABLE_DP:
            threshold = threshold_mem.read()
            count_ok = (c_counts[i] >= threshold)
            keep = valid_last & count_ok
            if ENABLE_K_ANON:
                is_other = valid_last & (1 - count_ok)
                others_counts[i] = c_counts[i] * is_other
        else:
            keep = valid_last
            # K_ANON is a no-op when threshold=1 and no DP: nothing falls below.

        should_reveal_arr[i] = keep
        revealed_counts[i] = c_counts[i] * keep

        # Mask orig index: kept rows get real index, others get 0
        # This is safe — kept rows' traces are revealed anyway, so their
        # position in merged_data is not additional leakage.
        masked_orig_idx[i] = keep.if_else(narrow_keys[i][1], sint64(0))

    # Batch reveal: keep mask, counts, and masked original indices
    mask_list = should_reveal_arr.reveal()
    counts_list = revealed_counts.reveal()
    revealed_orig = masked_orig_idx.reveal()  # regint — safe for public indexing

    # Pass 2: Build flat array for activities (packed with conc_bit when PO)
    flat_traces = Array(TOTAL_N * FULL_LEN, sint64)
    flat_traces.assign_all(0)

    @for_range_opt_multithread(N_THREADS, TOTAL_N)
    def _(i):
        public_keep = mask_list[i]
        public_orig = revealed_orig[i]
        @if_(public_keep)
        def _():
            for k in range(FULL_LEN):
                flat_traces[i * FULL_LEN + k] = merged_data[public_orig][2 + k]

    traces_list = flat_traces.reveal()

    # Output print loop. PO mode unpacks activity | conc_bit per slot; plain mode
    # prints each activity ID directly. Structure is identical either way.
    @for_range_opt(TOTAL_N)
    def _(i):
        do_print = mask_list[i]
        @if_(do_print)
        def _():
            print_ln("RAW_RESULT Count:%s Trace:", counts_list[i])
            for k in range(FULL_LEN):
                val = traces_list[i * FULL_LEN + k]
                if ENABLE_PARTIAL_ORDERS:
                    act_val = val & ((1 << 32) - 1)
                    conc_val = val >> 32
                    print_ln("%s %s", act_val, conc_val)
                else:
                    print_ln("%s", val)
            print_ln("END_TRACE")
            
    if ENABLE_K_ANON:
        total_others = MemValue(sint64(0))
        @for_range_opt(TOTAL_N)
        def _(i):
            total_others.write(total_others.read() + others_counts[i])
        
        print_ln("Others count (below threshold): %s", total_others.read().reveal())
    
    stop_timer(NEON_TIMER_OUTPUT)

main()
