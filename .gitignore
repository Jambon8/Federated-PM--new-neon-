# Virtual environment
fed_env/
.deps/

# Python cache
__pycache__/
*.pyc
*.pyo

# Runtime — regenerated on every run
Player-Data/
vendor/logs/

# MP-SPDZ installation — large binaries, reinstall via:
#   python3 vendor/setup.py install-mpspdz
vendor/temp/

# NEON debug logging config (auto-generated)
vendor/config/debug_logging.conf

# Agent config
.claude/
CLAUDE.md
.codex/
AGENTS.md
.mcp.json

# Thesis sources, advisor feedback, and third-party reference theses
Thesis/

# Internal design notes. They record how the protocol was arrived at, not what
# it does; the thesis chapters are the published account and have moved past
# them. Kept locally as a development record.
docs/

# Event logs. Ignored by default so that a stray multi-gigabyte log never
# lands in a commit; the logs Chapter 6 actually measures are tracked
# explicitly and stay tracked. Add a new one with: git add -f <path>
data/

# Stray root-level LaTeX build artifacts from thesis compiles
/*.aux
/*.bbl
/*.blg
/*.fdb_latexmk
/*.fls
/*.log
/*.out
/*.synctex.gz
/*.toc

# Evaluation. The rule: what the thesis reports, or what produces a number the
# thesis reports, is tracked. Everything else stays local.
#
# Tracked: the experiment registry and the verifiers, the aggregated CSV per
# reported experiment, the verifier outputs, the provenance manifest, the raw
# per-run records (gzipped -- 3.7 GB of pretty-printed JSON becomes 21 MB), and
# the generated source of the three figures the thesis includes.
eval_results/*
!eval_results/*.csv
!eval_results/*.json
!eval_results/*/
eval_results/*/*.json

# Superseded by the controlled grid, which is what the thesis reports.
eval_results/scaling_input_size_superseded/
eval_results/scaling_input_size_superseded.csv

# Diagnostics whose output the thesis does not carry.
eval_results/stage_breakdown/
eval_results/scaling_plots/fig_e3_input_scaling.pdf
eval_results/scaling_plots/fig_e4_n_scaling.pdf
eval_results/scaling_plots/fig_e4b_party_scaling.pdf
eval_results/scaling_plots/fig_e4b_controlled_parties.pdf

# The pre-registry generation of standalone drivers. The registry superseded
# them; the directories they wrote to held the results retired on 2026-06-23.
eval/baseline.py
eval/correctness.py
eval/dp_evaluation.py
eval/partial_order.py
eval/performance.py
eval/privacy_utility.py
eval/configs/

# Plotting whose figures the thesis does not include.
eval/figures/plot_performance.py
eval/plotting/plot_dp.py
eval/plotting/plot_privacy.py
eval/plotting/plot_stage_breakdown.py
eval/plotting/e6_variant_diff.py

# Generated command lists
eval/commands*.txt

# Cluster orchestration. The published harness targets local execution;
# the SLURM/CLAIX wrappers stay local as a provenance record.
eval/claix_*.sh
eval/cluster_*
eval/run_on_hpc.sh
